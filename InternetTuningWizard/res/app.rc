#pragma code_page(65001)  // the © in LegalCopyright is UTF-8
// ============================================================================
//  app.rc — manifest, icon and version information.
// ============================================================================

#include <winver.h>

1 24 "app.manifest"

2 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Charles McDonald"
      VALUE "FileDescription",  "Internet Tuning Wizard for Windows 10 and Windows 11"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "internettuningwizard"
      VALUE "LegalCopyright",   "Copyright © 2026-2027 Charles McDonald. BSD 3-Clause License."
      VALUE "OriginalFilename", "InternetTuningWizard.exe"
      VALUE "ProductName",      "Internet Tuning Wizard"
      VALUE "ProductVersion",   "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
