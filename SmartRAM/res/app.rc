// app.rc — icon + version info.
#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Charles McDonald"
            VALUE "FileDescription", "Monitor and release memory"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SmartRAM"
            VALUE "LegalCopyright", "Copyright (C) 2026 Charles McDonald. BSD 3-Clause License."
            VALUE "OriginalFilename", "SmartRAM.exe"
            VALUE "ProductName", "Smart RAM"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
 END
