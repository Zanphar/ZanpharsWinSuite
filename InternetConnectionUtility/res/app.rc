#pragma code_page(65001)  // the © in LegalCopyright is UTF-8
// ============================================================================
//  app.rc — manifest, icon and version information.
// ============================================================================

#include <winver.h>
#include "resource.h"

1 24 "app.manifest"

IDI_APPICON ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Charles McDonald"
      VALUE "FileDescription",  "Internet Connection Utility - Connection Doctor"
      VALUE "FileVersion",      "1.4.0.0"
      VALUE "InternalName",     "internetconnectionutility"
      VALUE "LegalCopyright",   "Copyright © 2026-2027 Charles McDonald. BSD 3-Clause License."
      VALUE "OriginalFilename", "InternetConnectionUtility.exe"
      VALUE "ProductName",      "Internet Connection Utility"
      VALUE "ProductVersion",   "1.4.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
